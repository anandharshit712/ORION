# ── ORION Environment Configuration ─────────────────────────────────────
# Copy to .env and fill values. .env is gitignored.

# ── Environment ─────────────────────────────────────────────────────────
# dev | prod. Non-dev refuses weak/placeholder secrets and SQLite (fail-fast).
ORION_ENV=dev

# ── Database ────────────────────────────────────────────────────────────
# Dev: leave unset to default to sqlite:///arep.db. Prod: REQUIRED, no SQLite.
ORION_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orion

# ── JWT / Auth ──────────────────────────────────────────────────────────
# REQUIRED in prod. Must be >= 32 chars and not a placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ORION_SECRET_KEY=replace_with_a_32+_char_random_secret

# ── Redis (Celery broker + rate limiter) ────────────────────────────────
ORION_REDIS_URL=redis://localhost:6379/0

# ── SMTP (password reset, confirmations) ────────────────────────────────
# For Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=<your-gmail>
#   SMTP_PASS=<app-password>  (NOT your account password — generate at
#   https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ORION
SMTP_USE_TLS=true

# Public URL used to build reset links emailed to users.
# Frontend dev: http://localhost:5173 ; Prod: https://app.orion.run
ORION_PUBLIC_URL=http://localhost:5173

# ── Password reset ──────────────────────────────────────────────────────
RESET_TOKEN_TTL_MINUTES=15
RESET_RATE_LIMIT_PER_HOUR=5
