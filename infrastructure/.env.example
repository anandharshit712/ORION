# ── ORION docker-compose secrets ────────────────────────────────────────
# Copy to infrastructure/.env (git-ignored) and fill in real values.
# docker-compose auto-loads this file from the infrastructure/ directory.

# Deployment environment: dev | prod. Non-dev refuses weak secrets / SQLite.
ORION_ENV=dev

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_DB=orion
POSTGRES_USER=orion
# REQUIRED — compose refuses to start if unset.
POSTGRES_PASSWORD=replace_with_a_strong_password

# ── JWT signing secret ──────────────────────────────────────────────────
# REQUIRED in prod. Must be >= 32 chars and not a placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ORION_SECRET_KEY=replace_with_a_32+_char_random_secret

# ── API surface hardening (Phase 0.3, D-03) ─────────────────────────────
# Browser origins allowed to call the API, comma-separated. REQUIRED in prod:
# a non-dev ORION_ENV refuses to boot on "*" or on an empty list, because the
# API is served with credentials and a wildcard is invalid (and unsafe) there.
ORION_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting. Leave enabled outside throwaway environments.
ORION_RATE_LIMIT_ENABLED=true
ORION_RATE_LIMIT_LOGIN=5/minute
ORION_RATE_LIMIT_SIGNUP=3/hour
ORION_RATE_LIMIT_DEFAULT=120/minute
# memory:// counts per process, so N uvicorn workers means N x the limit.
# In prod point this at Redis — the Celery broker instance, separate db index:
#   ORION_RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
ORION_RATE_LIMIT_STORAGE_URI=memory://

# Set true ONLY when the API sits behind a proxy you control that overwrites
# X-Forwarded-For. If the API is reachable directly, a client can spoof the
# header and hand itself a fresh rate-limit bucket on every request.
ORION_TRUST_PROXY_HEADERS=false
