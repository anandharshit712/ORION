# ORION CLI — CI/CD evaluation image
# Used by the GitHub Action and GitLab CI integration.
FROM python:3.11-slim

WORKDIR /arep

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl && \
    rm -rf /var/lib/apt/lists/*

COPY arep_implementation/pyproject.toml arep_implementation/
COPY arep_implementation/arep/ arep_implementation/arep/
COPY arep_implementation/config/ arep_implementation/config/
RUN pip install --no-cache-dir -e "arep_implementation[api,worker]"

# Install the SDK CLI
COPY orion-sdk/ /orion-sdk/
RUN pip install --no-cache-dir /orion-sdk/

COPY scenarios/ /arep/scenarios/

# The CI entrypoint has to live inside the image. A Docker action referencing a
# prebuilt `image:` never mounts the action's own directory, so a script kept
# beside action.yml is not there at runtime -- which is why the action's
# env-var configuration was read by nothing.
COPY ci/orion-ci.sh /usr/local/bin/orion-ci
RUN chmod +x /usr/local/bin/orion-ci

# Plain `docker run <image> --scenarios all ...` still works: the CI wrapper is
# an override, not a replacement.
ENTRYPOINT ["python", "-m", "arep.cli.run_suite"]
