<?xml version="1.0" standalone="yes"?>
<!--
  Hand-authored for ORION's tests (Phase 4.2). Not from any third-party map,
  not exported from a tool, and not a real place. Each geometry's start pose
  (x, y, hdg) was computed by integrating the geometry before it, so the plan
  view is continuous to well under a millimetre.

  Covers: line, spiral, arc, paramPoly3 (arcLength and normalized), poly3; a
  two-way road with a sidewalk; a one-way connecting road whose reference line
  is its left edge; a junction with two connecting roads; a traffic light; and
  a static sign and an object, which ORION does not model and must report.

  Road 1 (incoming, 170 m)   line 40 / spiral 0->0.01 / arc 0.01 / spiral 0.01->0 / paramPoly3
  Road 10 (connector)        straight through the junction, 20 m
  Road 11 (connector)        right turn, radius 12 m on its reference line
  Road 2  (outgoing, 150 m)  poly3
  Road 3  (after the turn)   paramPoly3, normalized
-->
<OpenDRIVE>
  <header revMajor="1" revMinor="7" name="orion_junction" version="1.0"/>

  <road name="approach" length="170.016186" id="1" junction="-1">
    <link><successor elementType="junction" elementId="100"/></link>
    <type s="0.0" type="town"><speed max="50" unit="km/h"/></type>
    <planView>
      <geometry s="0.000000" x="0.000000" y="0.000000" hdg="0.000000000" length="40.000000"><line/></geometry>
      <geometry s="40.000000" x="40.000000" y="0.000000" hdg="0.000000000" length="30.000000"><spiral curvStart="0.0" curvEnd="0.01"/></geometry>
      <geometry s="70.000000" x="69.932570" y="1.497593" hdg="0.150000000" length="40.000000"><arc curvature="0.01"/></geometry>
      <geometry s="110.000000" x="107.257479" y="15.122248" hdg="0.550000000" length="30.000000"><spiral curvStart="0.01" curvEnd="0.0"/></geometry>
      <geometry s="140.000000" x="131.115947" y="33.259917" hdg="0.700000000" length="30.016186"><paramPoly3 aU="0.0" bU="1.0" cU="0.0" dU="0.0" aV="0.0" bV="0.0" cV="0.003" dV="-0.0001" pRange="arcLength"/></geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <left>
          <lane id="1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </left>
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
          <lane id="-2" type="sidewalk" level="false"><width sOffset="0.0" a="2.0" b="0.0" c="0.0" d="0.0"/></lane>
        </right>
      </laneSection>
    </lanes>
    <signals>
      <signal s="165.0" t="-5.0" id="500" name="approach_light" dynamic="yes" orientation="+" type="1000001" subtype="-1" country="DEU"/>
    </signals>
  </road>

  <road name="through" length="20.000000" id="10" junction="100">
    <link>
      <predecessor elementType="road" elementId="1" contactPoint="end"/>
      <successor elementType="road" elementId="2" contactPoint="start"/>
    </link>
    <type s="0.0" type="town"><speed max="50" unit="km/h"/></type>
    <planView>
      <geometry s="0.000000" x="154.074532" y="52.595760" hdg="0.610049080" length="20.000000"><line/></geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <left>
          <lane id="1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </left>
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </right>
      </laneSection>
    </lanes>
  </road>

  <road name="right_turn" length="18.849556" id="11" junction="100">
    <link>
      <predecessor elementType="road" elementId="1" contactPoint="end"/>
      <successor elementType="road" elementId="3" contactPoint="start"/>
    </link>
    <type s="0.0" type="town"><speed max="30" unit="km/h"/></type>
    <planView>
      <geometry s="0.000000" x="154.074532" y="52.595760" hdg="0.610049080" length="18.849556"><arc curvature="-0.083333333"/></geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </right>
      </laneSection>
    </lanes>
  </road>

  <road name="departure" length="150.000000" id="2" junction="-1">
    <link><predecessor elementType="junction" elementId="100"/></link>
    <type s="0.0" type="town"><speed max="50" unit="km/h"/></type>
    <planView>
      <geometry s="0.000000" x="170.466930" y="64.053914" hdg="0.610049080" length="150.000000"><poly3 a="0.0" b="0.0" c="0.0003" d="-0.000001"/></geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <left>
          <lane id="1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </left>
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </right>
      </laneSection>
    </lanes>
    <objects>
      <object id="700" name="bollard" type="pole" s="40.0" t="-6.0" zOffset="0.0" orientation="none" height="1.0" radius="0.1"/>
    </objects>
    <signals>
      <signal s="20.0" t="-5.0" id="501" name="speed_sign" dynamic="no" orientation="+" type="274" subtype="55" country="DEU"/>
    </signals>
  </road>

  <road name="side_street" length="60.002500" id="3" junction="-1">
    <link><predecessor elementType="junction" elementId="100"/></link>
    <type s="0.0" type="town"><speed max="30" unit="km/h"/></type>
    <planView>
      <geometry s="0.000000" x="170.784839" y="49.635218" hdg="-0.960747247" length="60.002500"><paramPoly3 aU="0.0" bU="60.0" cU="0.0" dU="0.0" aV="0.0" bV="0.0" cV="1.5" dV="-1.0" pRange="normalized"/></geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <left>
          <lane id="1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </left>
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane>
        </right>
      </laneSection>
    </lanes>
  </road>

  <junction id="100" name="signalised_t">
    <connection id="0" incomingRoad="1" connectingRoad="10" contactPoint="start">
      <laneLink from="-1" to="-1"/>
    </connection>
    <connection id="1" incomingRoad="1" connectingRoad="11" contactPoint="start">
      <laneLink from="-1" to="-1"/>
    </connection>
    <priority high="10" low="11"/>
  </junction>
</OpenDRIVE>
